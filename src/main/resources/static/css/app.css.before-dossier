/* 修仙台 · 夜修洞府
   墨色为底，宣纸色为字；朱砂只用于"完成"和"行动"，鎏金只用于境界与进度，青碧表示灵气与进行中。 */

:root {
  color-scheme: dark;
  --ink-0: #090b0f;
  --ink-1: #0e1116;
  --paper: #ece3cd;
  --paper-2: #c4b99f;
  --paper-3: #918871;
  --gold: #c9a562;
  --gold-hi: #ead096;
  --gold-dim: rgba(201, 165, 98, 0.55);
  --cinnabar: #a8352a;
  --cinnabar-hi: #c4473a;
  --seal: #c0402f;
  --jade: #5fb9a5;
  --line: rgba(201, 165, 98, 0.15);
  --line-2: rgba(201, 165, 98, 0.28);
  --line-3: rgba(201, 165, 98, 0.5);
  --xuan: #efe6cf;
  --ink: #2b241c;
  --ink-2: #5b4f3f;
  --ink-3: #8a7b63;
  --font-brush: 'Ma Shan Zheng', 'LXGW WenKai', 'KaiTi', 'STKaiti', serif;
  --font-body: 'LXGW WenKai', 'KaiTi', 'STKaiti', 'Songti SC', 'Noto Serif SC', 'SimSun', serif;
  --font-mono: 'LXGW WenKai Mono', 'LXGW WenKai', ui-monospace, 'Consolas', monospace;
  --shadow: 0 12px 32px rgba(0, 0, 0, 0.38);
  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-back: cubic-bezier(0.3, 1.5, 0.5, 1);
  --panel-bg: linear-gradient(180deg, rgba(29, 33, 41, 0.92), rgba(20, 23, 29, 0.92));
}

* { box-sizing: border-box; }
html, body { margin: 0; min-height: 100%; }
body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  color: var(--paper);
  background: var(--ink-0);
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
  overflow-x: hidden;
}
a { color: var(--gold); }
button { font: inherit; }
:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
::selection { background: rgba(192, 64, 47, 0.45); color: #fff; }

/* —— 天幕 —— */

.sky {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background:
    radial-gradient(ellipse 60% 40% at 80% 6%, rgba(236, 214, 160, 0.1), transparent 70%),
    radial-gradient(ellipse 80% 50% at 12% 100%, rgba(95, 185, 165, 0.06), transparent 70%),
    linear-gradient(180deg, #0a0c11 0%, #0e1118 45%, #161b25 78%, #0e1117 100%);
}
.moon {
  position: absolute;
  top: 2vh;
  right: 1.2vw;
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 36%, #f6eedb, #e3d6b4 55%, #c9b88e 100%);
  opacity: 0.32;
  box-shadow: 0 0 60px 14px rgba(236, 214, 160, 0.16), 0 0 160px 60px rgba(236, 214, 160, 0.06);
}
.moon::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle at 62% 58%, rgba(150, 135, 100, 0.28) 0 8%, transparent 9%),
    radial-gradient(circle at 40% 68%, rgba(150, 135, 100, 0.22) 0 5%, transparent 6%),
    radial-gradient(circle at 70% 32%, rgba(150, 135, 100, 0.2) 0 6%, transparent 7%);
}
.mist {
  position: absolute;
  left: -30%;
  width: 160%;
  height: 26vh;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(205, 214, 228, 0.07), transparent 65%);
  filter: blur(20px);
  animation: drift 90s ease-in-out infinite alternate;
}
.mist-1 { bottom: 16vh; }
.mist-2 { bottom: 3vh; opacity: 0.8; animation-duration: 130s; animation-direction: alternate-reverse; }
.mountains { position: absolute; left: 0; bottom: 0; width: 100%; height: 34vh; min-height: 200px; }
.motes i {
  position: absolute;
  bottom: -10px;
  left: var(--x);
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #f1d9a0;
  box-shadow: 0 0 8px 2px rgba(241, 217, 160, 0.55);
  opacity: 0;
  animation: rise var(--t) linear var(--d) infinite;
}
.grain {
  position: absolute;
  inset: 0;
  opacity: 0.07;
  mix-blend-mode: overlay;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .93  0 0 0 0 .89  0 0 0 0 .8  0 0 0 .55 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
}

/* —— 外壳 —— */

.shell { position: relative; z-index: 1; }
.rail {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  width: 92px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 18px 0;
  border-right: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(14, 17, 22, 0.92), rgba(10, 12, 16, 0.92));
}
.logo { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 18px; text-decoration: none; }
.logo-text {
  writing-mode: vertical-rl;
  font-family: var(--font-brush);
  font-size: 30px;
  letter-spacing: 0.18em;
  color: var(--gold-hi);
  text-shadow: 0 0 18px rgba(234, 208, 150, 0.25);
}
.logo-seal {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 3px;
  background: var(--seal);
  color: #f6e7d0;
  font-family: var(--font-brush);
  font-size: 15px;
  filter: url(#seal-rough);
  transform: rotate(-6deg);
}
.rail-item, .tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  text-decoration: none;
  color: var(--paper-3);
}
.rail-item { width: 76px; padding: 8px 0; border-radius: 6px; }
.nav-seal {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-2);
  border-radius: 4px;
  font-family: var(--font-brush);
  font-size: 20px;
  color: var(--gold);
  transition: all 0.2s;
}
.nav-label { font-size: 13px; letter-spacing: 0.06em; }
.rail-item:hover .nav-seal { border-color: var(--gold); color: var(--gold-hi); }
.rail-item.on .nav-seal, .tab.on .nav-seal {
  background: var(--seal);
  border-color: var(--seal);
  color: #f6e7d0;
  filter: url(#seal-rough);
  transform: rotate(-4deg);
}
.rail-item.on, .tab.on { color: var(--paper); }
.topbar, .tabbar { display: none; }
.main { position: relative; margin-left: 92px; max-width: 1260px; padding: 26px 34px 90px; }

.offline {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
  padding: 10px 14px;
  border: 1px solid rgba(192, 64, 47, 0.5);
  border-radius: 6px;
  background: rgba(192, 64, 47, 0.1);
  color: #f0c2b8;
}

.incense-pill {
  position: fixed;
  right: 22px;
  bottom: 22px;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border: 1px solid rgba(255, 170, 90, 0.45);
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(40, 32, 24, 0.95), rgba(26, 21, 16, 0.95));
  color: var(--paper);
  font-family: var(--font-mono);
  text-decoration: none;
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.5), 0 0 18px rgba(255, 140, 70, 0.15);
}
.incense-pill small { font-family: var(--font-brush); font-size: 15px; color: var(--gold-hi); }
.pill-ember {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ffb45a;
  box-shadow: 0 0 10px #ff8a3c;
  animation: ember 2.4s ease-in-out infinite;
}
.incense-pill.paused .pill-ember { background: #8a4e38; box-shadow: none; animation: none; }

/* —— 面板与标题 —— */

.view { display: flex; flex-direction: column; gap: 18px; }
.view.loading { min-height: 50vh; display: grid; place-items: center; }
.view-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; }
.view-title {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin: 0;
  font-family: var(--font-brush);
  font-size: 38px;
  font-weight: normal;
  letter-spacing: 0.14em;
  color: var(--gold-hi);
  text-shadow: 0 0 22px rgba(234, 208, 150, 0.2);
}
.view-title small, .panel-title small {
  font-family: var(--font-body);
  font-size: 13px;
  letter-spacing: 0.04em;
  color: var(--paper-3);
}
.view-head .btn { margin-left: auto; }
.view-note { flex-basis: 100%; margin: 0; font-size: 14px; color: var(--paper-3); }

.panel {
  position: relative;
  padding: 16px 20px 18px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--panel-bg);
  box-shadow: var(--shadow), inset 0 1px 0 rgba(234, 208, 150, 0.05);
}
.panel.ornate {
  background:
    linear-gradient(var(--gold-dim), var(--gold-dim)) left 6px top 6px / 16px 1px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) left 6px top 6px / 1px 16px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) right 6px top 6px / 16px 1px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) right 6px top 6px / 1px 16px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) left 6px bottom 6px / 16px 1px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) left 6px bottom 6px / 1px 16px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) right 6px bottom 6px / 16px 1px no-repeat,
    linear-gradient(var(--gold-dim), var(--gold-dim)) right 6px bottom 6px / 1px 16px no-repeat,
    radial-gradient(ellipse at 50% 0%, rgba(201, 165, 98, 0.08), transparent 60%),
    var(--panel-bg);
}
.panel-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.panel-head > .btn-text:last-child, .panel-head > .btn:last-child { margin-left: auto; }
.panel-title {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin: 0;
  font-family: var(--font-brush);
  font-size: 24px;
  font-weight: normal;
  letter-spacing: 0.1em;
  color: var(--gold-hi);
}
.panel-title::before {
  content: '';
  align-self: center;
  width: 7px;
  height: 7px;
  margin-right: 2px;
  background: var(--seal);
  transform: rotate(45deg);
  box-shadow: 0 0 8px rgba(192, 64, 47, 0.6);
}
.panel-note { color: var(--paper-3); font-size: 13px; }
.empty-note { margin: 8px 0; color: var(--paper-3); font-size: 14px; }
.hint { margin: 6px 0 0; color: var(--paper-3); font-size: 13px; }

/* —— 按钮、标签、输入 —— */

.btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 6px 18px;
  border: 1px solid transparent;
  border-radius: 5px;
  background: none;
  color: var(--paper);
  font-family: var(--font-brush);
  font-size: 20px;
  line-height: 1.15;
  letter-spacing: 0.14em;
  cursor: pointer;
  text-decoration: none;
  transition: transform 0.12s, box-shadow 0.2s, background 0.2s, border-color 0.2s, color 0.2s;
}
.btn small { font-family: var(--font-body); font-size: 11px; letter-spacing: 0.06em; opacity: 0.75; }
.btn:disabled { opacity: 0.5; cursor: default; }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn.small { min-height: 32px; padding: 4px 12px; font-size: 16px; }
.btn-seal {
  border-color: rgba(255, 214, 190, 0.22);
  background: radial-gradient(circle at 30% 25%, #c4473a, #9b2f24 70%);
  color: #f7e9d2;
  box-shadow: inset 0 0 0 3px rgba(0, 0, 0, 0.12), inset 0 0 0 4px rgba(247, 233, 210, 0.22), 0 6px 18px rgba(168, 53, 42, 0.35);
}
.btn-seal:hover:not(:disabled) {
  box-shadow: inset 0 0 0 3px rgba(0, 0, 0, 0.12), inset 0 0 0 4px rgba(247, 233, 210, 0.4), 0 8px 24px rgba(196, 71, 58, 0.5);
}
.btn-jade {
  border-color: rgba(160, 230, 210, 0.25);
  background: linear-gradient(180deg, #3f8d7e, #2c6b5f);
  color: #eaf6f1;
  box-shadow: 0 6px 16px rgba(63, 141, 126, 0.25);
}
.btn-jade:hover:not(:disabled) { background: linear-gradient(180deg, #48a08f, #317769); }
.btn-ghost { border-color: var(--line-2); color: var(--paper-2); }
.btn-ghost:hover:not(:disabled) { border-color: var(--gold); color: var(--paper); background: rgba(201, 165, 98, 0.06); }
.btn-ink { border-color: var(--ink); background: var(--ink); color: var(--xuan); }
.btn-ink:hover { background: #3d3327; }
.btn-text {
  padding: 4px 6px;
  border: 0;
  background: none;
  color: var(--gold);
  font-size: 14px;
  cursor: pointer;
}
.btn-text:hover:not(:disabled) { color: var(--gold-hi); text-decoration: underline; text-underline-offset: 3px; }
.btn-text:disabled { opacity: 0.5; cursor: default; }
.btn-text.faint { color: var(--paper-3); }
.btn-text.danger { color: #d97a6a; }
.btn-text.ink { color: var(--ink-2); }

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 14px;
  border: 1px solid var(--line-2);
  border-radius: 999px;
  background: rgba(24, 27, 34, 0.6);
  color: var(--paper-2);
  font-size: 14px;
  cursor: pointer;
}
.chip:hover { border-color: var(--line-3); }
.chip.on { border-color: var(--gold); background: rgba(201, 165, 98, 0.16); color: var(--gold-hi); }
.chip small { font-size: 12px; color: var(--paper-3); }
.chip.small { padding: 2px 10px; font-size: 13px; }
.filter-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }

.input {
  min-width: 0;
  padding: 8px 10px;
  border: 1px solid var(--line-2);
  border-radius: 5px;
  background: rgba(9, 11, 15, 0.6);
  color: var(--paper);
  font: inherit;
  font-size: 15px;
}
.input:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201, 165, 98, 0.15); }
.input::placeholder { color: rgba(145, 136, 113, 0.7); }
.input.narrow { width: 90px; }
.input.color { width: 44px; height: 36px; padding: 2px; }
textarea.input { width: 100%; resize: vertical; line-height: 1.7; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
.field > span:first-child { color: var(--paper-3); font-size: 13px; letter-spacing: 0.1em; }
.field small { color: var(--paper-3); font-size: 12px; }
.row { display: flex; align-items: center; gap: 8px; }
.row.wrap { flex-wrap: wrap; }
.grow { flex: 1; }
.toggle { display: inline-flex; align-items: center; gap: 6px; color: var(--paper-2); font-size: 14px; cursor: pointer; }
.toggle input { width: 16px; height: 16px; accent-color: var(--seal); }

/* —— 朱印复选框 —— */

.seal-box {
  position: relative;
  flex: none;
  width: 34px;
  height: 34px;
  padding: 0;
  border: 1px solid var(--line-2);
  border-radius: 5px;
  background: rgba(8, 10, 14, 0.45);
  cursor: pointer;
  transition: border-color 0.2s;
}
.seal-box:hover:not(:disabled) { border-color: var(--line-3); }
.seal-box:disabled { cursor: default; }
.seal-mark {
  position: absolute;
  inset: 3px;
  display: grid;
  place-items: center;
  border-radius: 3px;
  font-family: var(--font-brush);
  font-size: 21px;
  line-height: 1;
  color: transparent;
  opacity: 0;
  transform: rotate(-8deg) scale(0.7);
  transition: opacity 0.2s, transform 0.2s;
}
.seal-box:hover:not(.on):not(:disabled) .seal-mark {
  opacity: 0.25;
  color: var(--seal);
  box-shadow: inset 0 0 0 1.5px var(--seal);
  transform: rotate(-8deg) scale(0.92);
}
.seal-box.on .seal-mark {
  opacity: 1;
  background: var(--seal);
  color: #f6e7d0;
  transform: rotate(-8deg);
  filter: url(#seal-rough);
}
.seal-box.stamping .seal-mark { animation: stamp 0.5s var(--ease-back); }
.seal-box.stamping::after {
  content: '';
  position: absolute;
  inset: -5px;
  border: 2px solid rgba(192, 64, 47, 0.55);
  border-radius: 8px;
  pointer-events: none;
  animation: inkring 0.6s ease-out forwards;
}

/* —— 境界条 —— */

.realm-bar { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
.realm-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
.realm-caption { font-size: 13px; letter-spacing: 0.1em; color: var(--paper-3); }
.realm-name {
  font-family: var(--font-brush);
  font-size: 28px;
  letter-spacing: 0.08em;
  color: var(--gold-hi);
  text-shadow: 0 0 16px rgba(234, 208, 150, 0.25);
}
.realm-next { margin-left: auto; font-size: 13px; color: var(--paper-3); }
.bar { position: relative; height: 6px; overflow: hidden; border-radius: 3px; background: rgba(201, 165, 98, 0.12); }
.bar-fill {
  position: relative;
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, #8a6a33, var(--gold) 60%, var(--gold-hi));
  transition: width 0.8s var(--ease-out);
}
.bar-fill::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
  transform: translateX(-100%);
  animation: shimmer 3.2s ease-in-out infinite;
}
.realm-bar.compact .realm-name { font-size: 21px; }
.tone-jade .realm-name { color: #9fdccd; text-shadow: 0 0 14px rgba(95, 185, 165, 0.25); }
.tone-jade .bar { background: rgba(95, 185, 165, 0.12); }
.tone-jade .bar-fill { background: linear-gradient(90deg, #2f6a5e, var(--jade)); }

/* —— 洞府 —— */

.home { gap: 18px; }
.heaven { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 26px; padding: 2px; }
.heaven-time { display: flex; align-items: baseline; gap: 12px; }
.lunar { font-family: var(--font-brush); font-size: 26px; letter-spacing: 0.08em; color: var(--gold-hi); }
.hour { font-family: var(--font-brush); font-size: 22px; color: var(--paper-2); }
.almanac { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--paper-2); }
.almanac b {
  display: inline-grid;
  place-items: center;
  width: 22px;
  height: 22px;
  margin-right: 6px;
  border-radius: 3px;
  font-family: var(--font-brush);
  font-size: 15px;
  font-weight: normal;
}
.almanac .yi { border: 1px solid rgba(95, 185, 165, 0.35); background: rgba(95, 185, 165, 0.16); color: var(--jade); }
.almanac .ji { border: 1px solid rgba(192, 64, 47, 0.35); background: rgba(192, 64, 47, 0.14); color: #e08a7a; }
.countdowns { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
.countdown {
  padding: 2px 12px;
  border: 1px solid var(--line-2);
  border-radius: 999px;
  background: rgba(14, 17, 22, 0.85);
  color: var(--paper-2);
  font-size: 14px;
  text-decoration: none;
}
.countdown b { margin: 0 4px; font-family: var(--font-mono); font-size: 18px; color: var(--cinnabar-hi); }
.greet { flex-basis: 100%; margin: 0; font-size: 14px; color: var(--paper-3); }

.realm-head {
  display: grid;
  grid-template-columns: auto 1fr minmax(190px, 270px);
  align-items: center;
  gap: 14px 30px;
  padding: 16px 22px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: linear-gradient(90deg, rgba(201, 165, 98, 0.08), rgba(201, 165, 98, 0) 60%), rgba(17, 20, 26, 0.94);
}
.dao-name { display: block; font-family: var(--font-brush); font-size: 30px; letter-spacing: 0.12em; color: var(--paper); }
.dao-visit { font-size: 13px; color: var(--paper-3); }

.home-main { display: grid; grid-template-columns: minmax(300px, 5fr) 7fr; align-items: start; gap: 18px; }
.daily-count { margin-left: auto; color: var(--paper-3); }
.daily-count b { font-family: var(--font-mono); font-size: 20px; font-weight: normal; color: var(--gold-hi); }
.meridians {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 14px;
  margin-bottom: 6px;
  padding: 4px 0 12px;
  border-bottom: 1px solid var(--line);
}
.meridians-label { font-size: 13px; letter-spacing: 0.1em; color: var(--paper-3); }
.meridian { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--paper-3); }
.meridian i {
  width: 22px;
  height: 6px;
  border-radius: 3px;
  background: color-mix(in srgb, var(--c) 25%, transparent);
  transition: all 0.4s;
}
.meridian.lit { color: var(--paper); }
.meridian.lit i { background: var(--c); box-shadow: 0 0 10px var(--c), 0 0 2px var(--c); }
.meridians.all .meridian.lit i { animation: pulse 2.6s ease-in-out infinite; }
.meridians-done { margin-left: auto; font-family: var(--font-brush); font-size: 18px; color: var(--gold-hi); text-shadow: 0 0 12px rgba(234, 208, 150, 0.4); }
.daily-list { margin: 0; padding: 0; list-style: none; }
.daily-item { display: flex; align-items: center; gap: 12px; padding: 9px 2px; border-bottom: 1px solid rgba(201, 165, 98, 0.07); }
.daily-name { font-size: 17px; transition: color 0.3s; }
.daily-note { font-size: 13px; color: var(--paper-3); }
.daily-vein { width: 4px; height: 18px; margin-left: auto; border-radius: 2px; opacity: 0.8; }
.daily-item.done .daily-name { color: var(--paper-3); }
.add-item { margin-top: 10px; }
.add-item .input { flex: 1; }

/* 静室 */
.chamber.active {
  box-shadow: var(--shadow), 0 0 0 1px rgba(201, 165, 98, 0.18), 0 0 46px rgba(255, 150, 80, 0.07);
}
.chamber-active, .chamber-idle { display: grid; grid-template-columns: 160px 1fr; align-items: center; gap: 10px 22px; }
.chamber.big .chamber-active { grid-template-columns: 250px 1fr; }
.chamber.big .chamber-idle { grid-template-columns: 200px 1fr; }
.chamber-incense { display: block; width: 100%; height: auto; max-height: 270px; }
.clock {
  font-family: var(--font-mono);
  font-size: 52px;
  line-height: 1.1;
  letter-spacing: 0.04em;
  font-variant-numeric: tabular-nums;
  color: var(--paper);
  text-shadow: 0 0 24px rgba(236, 227, 205, 0.12);
}
.chamber.big .clock { font-size: 72px; }
.clock.paused { color: var(--paper-3); }
.chamber-method { margin-top: 4px; font-family: var(--font-brush); font-size: 24px; color: var(--gold-hi); }
.chamber-line { margin: 2px 0 14px; font-size: 14px; color: var(--paper-3); }
.chamber-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 6px; }
.chamber-actions .btn { min-width: 96px; }
.chamber-hint { margin: 0 0 12px; color: var(--paper-2); }
.chamber-more { margin: 10px 0 0; text-align: right; font-size: 14px; }
.picker { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.lot {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px 10px 16px;
  border: 1px solid var(--line-2);
  border-radius: 5px;
  background: linear-gradient(180deg, rgba(40, 44, 54, 0.6), rgba(26, 29, 36, 0.6));
  color: var(--paper);
  text-align: left;
  cursor: pointer;
  transition: transform 0.15s, border-color 0.2s, box-shadow 0.2s;
}
.lot:hover:not(:disabled) {
  border-color: var(--gold);
  transform: translateY(-2px);
  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(201, 165, 98, 0.2);
}
.lot:disabled { opacity: 0.6; cursor: default; }
.lot-vein { position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; border-radius: 2px; }
.lot-name { font-family: var(--font-brush); font-size: 21px; line-height: 1.2; color: var(--gold-hi); }
.lot-sub { overflow: hidden; font-size: 12px; color: var(--paper-3); white-space: nowrap; text-overflow: ellipsis; }

/* 香炉 */
.incense .ember { fill: #ffc27a; }
.incense .glow { transform-box: fill-box; transform-origin: center; animation: ember 2.4s ease-in-out infinite; }
.incense .wisp {
  fill: none;
  stroke: rgba(232, 226, 212, 0.78);
  stroke-width: 2.6;
  stroke-linecap: round;
  stroke-dasharray: 30 86;
  animation: wisp 3.8s linear infinite;
}
.incense .w2 { stroke-width: 2; animation-duration: 4.6s; animation-delay: -1.7s; }
.incense .w3 { stroke: rgba(222, 217, 202, 0.55); stroke-width: 3.4; animation-duration: 5.4s; animation-delay: -3.1s; }
.incense .smoke { transition: opacity 1.5s; }
.incense.idle .glow, .incense.idle .smoke { display: none; }
.incense.idle .ember { fill: #5a3a2b; }
.incense.paused .glow { opacity: 0.2; animation: none; }
.incense.paused .ember { fill: #8a4e38; }
.incense.paused .smoke { opacity: 0.1; }
.incense.paused .wisp { animation-play-state: paused; }

/* 统计 */
.spirit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; transition: opacity 0.2s; }
.spirit-grid > *, .home-main > *, .library-grid > * { min-width: 0; }
.spirit-grid.refreshing { opacity: 0.65; }
.spirit .filter-row { margin-bottom: 10px; }
.log-state { margin-left: auto; font-size: 13px; color: var(--paper-3); }
.log-input { min-height: 80px; }

.tools { padding: 10px 16px; border: 1px solid var(--line); border-radius: 8px; background: rgba(15, 18, 23, 0.7); }
.tools-toggle {
  padding: 2px 0;
  border: 0;
  background: none;
  color: var(--paper-2);
  font-family: var(--font-brush);
  font-size: 20px;
  letter-spacing: 0.1em;
  cursor: pointer;
}
.tools-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
.tool {
  display: grid;
  grid-template-columns: auto auto;
  grid-template-rows: auto auto;
  align-items: center;
  column-gap: 10px;
  padding: 8px 14px 8px 8px;
  border: 1px solid var(--line-2);
  border-radius: 6px;
  background: rgba(30, 34, 42, 0.6);
  color: var(--paper);
  text-align: left;
  text-decoration: none;
  cursor: pointer;
}
.tool:hover { border-color: var(--gold); }
.tool small { font-size: 12px; color: var(--paper-3); }
.tool-icon {
  grid-row: span 2;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-3);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(234, 208, 150, 0.18), transparent 70%);
  font-family: var(--font-brush);
  font-size: 19px;
  color: var(--gold-hi);
}
.tool-sound { cursor: default; }
.tool-sound .row { gap: 4px; }
.note-form { margin-top: 10px; }
.note-form .input { flex: 1; }

/* —— 图表 —— */

.donut-wrap { display: grid; grid-template-columns: minmax(180px, 250px) 1fr; align-items: center; gap: 18px; }
.donut-figure { position: relative; }
.donut { display: block; width: 100%; height: auto; overflow: visible; }
.formation { transform-box: fill-box; transform-origin: center; animation: spin 240s linear infinite; }
.formation .ring { fill: none; stroke: rgba(201, 165, 98, 0.28); }
.formation .ring.faint { stroke: rgba(201, 165, 98, 0.12); }
.formation .tick { stroke: rgba(201, 165, 98, 0.25); }
.formation .tick.long { stroke: rgba(201, 165, 98, 0.55); }
.formation .trigram { fill: rgba(201, 165, 98, 0.6); font-size: 11px; font-family: 'Segoe UI Symbol', 'Noto Sans Symbols 2', 'Apple Symbols', sans-serif; }
.donut-track { fill: none; stroke: rgba(201, 165, 98, 0.08); stroke-width: 18; }
.donut-arc { fill: none; stroke-width: 18; outline: none; cursor: pointer; transition: stroke-width 0.2s, opacity 0.2s, filter 0.2s; }
.donut-arc.on, .donut-arc:focus-visible { stroke-width: 23; filter: brightness(1.15); }
.donut-arc.dim { opacity: 0.5; }
.donut-total { fill: var(--paper); font-family: var(--font-body); font-size: 19px; }
.donut-label { fill: var(--paper-3); font-size: 12px; letter-spacing: 0.1em; }
.donut-delta { margin: 0 0 8px; font-size: 13px; color: var(--paper-3); }
.donut-delta.up { color: var(--jade); }
.donut-legend { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
.donut-legend li {
  display: grid;
  grid-template-columns: 12px 1fr auto 52px;
  align-items: center;
  gap: 10px;
  padding: 5px 8px;
  border-radius: 4px;
  font-size: 14px;
}
.donut-legend li.on { background: rgba(201, 165, 98, 0.08); }
.swatch { width: 12px; height: 12px; border-radius: 3px; }
.lg-val { color: var(--paper-2); font-variant-numeric: tabular-nums; }
.lg-pct { color: var(--paper-3); text-align: right; font-variant-numeric: tabular-nums; }

.chart-tip {
  position: absolute;
  z-index: 5;
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 110px;
  padding: 8px 12px;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 6px;
  background: linear-gradient(180deg, rgba(236, 230, 212, 0.97), rgba(214, 206, 182, 0.97));
  color: var(--ink);
  white-space: nowrap;
  pointer-events: none;
  transform: translate(-50%, calc(-100% - 14px));
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45);
}
.chart-tip strong { font-size: 17px; font-weight: normal; }
.tip-row { font-size: 13px; color: var(--ink-2); }
.tip-sub { font-size: 12px; color: var(--ink-3); }
.tip-row .key { display: inline-block; width: 12px; height: 3px; margin-right: 6px; border-radius: 2px; vertical-align: middle; }

.bars-wrap { position: relative; width: 100%; min-width: 0; }
.bars { display: block; width: 100%; height: auto; overflow: visible; }
.bars .grid line { stroke: rgba(201, 165, 98, 0.1); shape-rendering: crispEdges; }
.bars .grid line.base { stroke: rgba(201, 165, 98, 0.3); }
.bars .grid text { fill: var(--paper-3); font-size: 11px; }
.bars .bar { fill: #8f8775; transition: fill 0.2s; }
.bars .bar.today { fill: #d9b45f; }
.bars .bar.on { fill: #b9af97; }
.bars .bar.today.on { fill: #ecd29a; }
.bars .bar-value { fill: var(--paper-2); font-size: 11px; }
.bars .bar-label { fill: var(--paper-3); font-size: 12px; }
.bars .bar-label.today { fill: var(--gold-hi); }
.bars .hit { fill: transparent; outline: none; cursor: pointer; }
.bars .hit:focus-visible { fill: rgba(201, 165, 98, 0.07); }

.table { width: 100%; border-collapse: collapse; font-size: 14px; }
.table th, .table td { padding: 6px 8px; border-bottom: 1px solid rgba(201, 165, 98, 0.1); text-align: left; }
.table th { font-weight: normal; color: var(--paper-3); }
.table th:last-child, .table td:last-child { text-align: right; font-variant-numeric: tabular-nums; }

/* —— 浮层 —— */

.veil {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 20px;
  overflow-y: auto;
  background: rgba(5, 6, 9, 0.68);
  backdrop-filter: blur(3px);
}
.veil-enter-from, .veil-leave-to { opacity: 0; }
.veil-enter-active, .veil-leave-active { transition: opacity 0.25s; }
.dialog {
  width: min(440px, 100%);
  padding: 22px 24px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  background: linear-gradient(180deg, #1c2029, #14171d);
  box-shadow: var(--shadow);
}
.dialog.wide { width: min(560px, 100%); }
.dialog-title { margin: 0 0 6px; font-family: var(--font-brush); font-size: 26px; font-weight: normal; letter-spacing: 0.08em; color: var(--gold-hi); }
.dialog-text { margin: 0 0 14px; color: var(--paper-2); }
.dialog-text.small { font-size: 14px; color: var(--paper-3); }
.dialog-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 12px; }
.dialog-split { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line); }
.dialog .row .input { flex: 1; }
.close-x {
  position: absolute;
  top: 8px;
  right: 10px;
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 50%;
  background: none;
  color: var(--paper-3);
  font-size: 24px;
  line-height: 1;
  cursor: pointer;
}
.close-x:hover { background: rgba(255, 255, 255, 0.05); color: var(--paper); }
.close-x.ink { color: var(--ink-3); }
.close-x.ink:hover { background: rgba(43, 36, 28, 0.08); color: var(--ink); }

.toasts {
  position: fixed;
  top: 16px;
  left: 50%;
  z-index: 130;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: max-content;
  max-width: 92vw;
  transform: translateX(-50%);
  pointer-events: none;
}
.toast {
  padding: 8px 18px;
  border: 1px solid var(--line-2);
  border-radius: 4px;
  background: linear-gradient(180deg, rgba(36, 40, 50, 0.96), rgba(24, 27, 34, 0.96));
  color: var(--paper);
  font-size: 15px;
  letter-spacing: 0.04em;
  cursor: pointer;
  pointer-events: auto;
  box-shadow: var(--shadow);
}
.toast-copy { font-family: var(--font-brush); font-size: 19px; color: var(--gold-hi); }
.toast-error { border-color: rgba(192, 64, 47, 0.6); color: #f0c2b8; }
.toast-enter-from, .toast-leave-to { opacity: 0; transform: translateY(-8px); }
.toast-enter-active, .toast-leave-active { transition: all 0.3s; }

.float-text {
  position: fixed;
  z-index: 120;
  font-family: var(--font-brush);
  font-size: 18px;
  color: var(--gold-hi);
  white-space: nowrap;
  text-shadow: 0 0 10px rgba(234, 208, 150, 0.5);
  pointer-events: none;
  transform: translate(-50%, -100%);
  animation: floatUp 1.4s var(--ease-out) forwards;
}

.main.shake { animation: shake 0.55s linear; }

/* —— 出关卷轴 —— */

.scroll { width: min(540px, 94vw); filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.6)); }
.roller {
  position: relative;
  z-index: 2;
  height: 16px;
  margin: 0 -14px;
  border-radius: 8px;
  background: linear-gradient(180deg, #3e2716 0%, #8a5a33 35%, #b07a47 50%, #7a4c2a 70%, #3a2414 100%);
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.5);
}
.roller::before, .roller::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 14px;
  height: 22px;
  border-radius: 4px;
  background: linear-gradient(180deg, #6b5228, #e0c27d 50%, #6b5228);
  transform: translateY(-50%);
}
.roller::before { left: -10px; }
.roller::after { right: -10px; }
.paper {
  max-height: 0;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 20% 0%, rgba(255, 255, 255, 0.35), transparent 60%),
    linear-gradient(180deg, #efe6cf, #e8dcc0);
  box-shadow: inset 0 0 40px rgba(120, 90, 40, 0.2);
  transition: max-height 0.9s var(--ease-out);
}
.scroll.open .paper { max-height: calc(100vh - 90px); overflow-y: auto; }
.paper-inner { position: relative; padding: 26px 34px 24px; color: var(--ink); }
.scroll-title { margin: 0; padding-left: 0.5em; font-family: var(--font-brush); font-size: 40px; font-weight: normal; letter-spacing: 0.5em; text-align: center; color: var(--ink); }
.scroll-method { margin: 2px 0 16px; font-family: var(--font-brush); font-size: 22px; text-align: center; color: #9b2f24; }
.scroll-rows { display: flex; flex-direction: column; gap: 12px; margin: 0; }
.scroll-rows > div { display: grid; grid-template-columns: 84px 1fr; align-items: start; gap: 12px; }
.scroll-rows dt { padding-top: 3px; font-size: 14px; letter-spacing: 0.1em; color: var(--ink-3); }
.scroll-rows dd { display: flex; flex-direction: column; gap: 4px; margin: 0; color: var(--ink); }
.scroll-rows b { font-size: 22px; font-weight: normal; }
.scroll-rows small { font-size: 13px; color: var(--ink-3); }
.ink-name { font-family: var(--font-brush); font-size: 20px; font-style: normal; color: var(--ink); }
.ink-bar { display: block; height: 6px; overflow: hidden; border-radius: 3px; background: rgba(43, 36, 28, 0.12); }
.ink-bar i { display: block; height: 100%; border-radius: 3px; background: linear-gradient(90deg, #4a3f31, var(--ink)); transition: width 1.1s var(--ease-out) 0.35s; }
.ink-bar.cinnabar i { background: linear-gradient(90deg, #c4473a, #9b2f24); }
.scroll-suggest {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  padding: 10px 12px;
  border: 1px solid rgba(43, 36, 28, 0.15);
  border-radius: 6px;
}
.scroll-suggest .seal-box { border-color: rgba(43, 36, 28, 0.35); background: rgba(255, 255, 255, 0.3); }
.scroll-copy { margin: 18px 0 0; font-family: var(--font-brush); font-size: 21px; text-align: center; color: #6d5f4a; }
.scroll-actions { display: flex; justify-content: center; align-items: center; gap: 18px; margin-top: 18px; }
.stamp {
  position: absolute;
  top: 20px;
  right: 24px;
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  border-radius: 6px;
  background: var(--seal);
  color: #f6e7d0;
  font-family: var(--font-brush);
  font-size: 25px;
  line-height: 1;
  writing-mode: vertical-rl;
  box-shadow: inset 0 0 0 3px var(--seal), inset 0 0 0 5px rgba(246, 231, 208, 0.7);
  filter: url(#seal-rough);
  transform: rotate(-10deg);
  animation: stampBig 0.55s var(--ease-back) both;
}

/* —— 渡劫 —— */

.tribulation {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: grid;
  place-items: center;
  overflow: hidden;
  outline: none;
  cursor: pointer;
  background: radial-gradient(ellipse at 50% 0%, rgba(30, 34, 48, 0.65), rgba(4, 5, 8, 0.94) 70%);
  animation: fadeIn 0.4s ease-out both;
}
.trib-clouds {
  position: absolute;
  inset: -10% -10% auto;
  height: 62%;
  background:
    radial-gradient(ellipse 40% 50% at 30% 20%, rgba(70, 74, 92, 0.9), transparent 70%),
    radial-gradient(ellipse 45% 55% at 70% 15%, rgba(56, 60, 78, 0.9), transparent 70%),
    radial-gradient(ellipse 60% 40% at 50% 30%, rgba(40, 44, 60, 0.95), transparent 75%);
  filter: blur(8px);
  animation: cloudsRoll 4s ease-in-out both;
}
.gentle .trib-clouds { background: radial-gradient(ellipse 50% 50% at 50% 70%, rgba(236, 208, 150, 0.16), transparent 70%); }
.bolt { position: absolute; top: 0; left: 52%; width: auto; height: 62vh; transform: translateX(-50%); }
.bolt.b2 { left: 36%; height: 48vh; }
.bolt polyline {
  fill: none;
  stroke: #f4f1ff;
  stroke-width: 3;
  stroke-linejoin: round;
  stroke-dasharray: 900;
  stroke-dashoffset: 900;
  opacity: 0;
  filter: drop-shadow(0 0 6px #b9c6ff) drop-shadow(0 0 18px #7d8cff);
}
.b1 polyline { animation: bolt 0.5s 0.35s ease-out forwards; }
.b2 polyline { animation: bolt 0.45s 1s ease-out forwards; }
.trib-flash { position: absolute; inset: 0; background: #e8ecff; opacity: 0; animation: flash 1.4s 0.35s linear forwards; }
.trib-text { position: relative; text-align: center; opacity: 0; transform: scale(0.9); transition: opacity 0.7s, transform 0.9s var(--ease-back); }
.phase-2 .trib-text { opacity: 1; transform: none; }
.trib-text::before {
  content: '';
  position: absolute;
  inset: -80px;
  z-index: -1;
  background: radial-gradient(circle, rgba(243, 217, 153, 0.3), transparent 65%);
}
.trib-text h2 {
  margin: 0;
  font-family: var(--font-brush);
  font-size: clamp(56px, 12vw, 120px);
  font-weight: normal;
  letter-spacing: 0.12em;
  color: var(--gold-hi);
  text-shadow: 0 0 30px rgba(234, 208, 150, 0.6), 0 0 80px rgba(234, 208, 150, 0.3);
}
.trib-text p { margin: 4px 0 18px; font-size: 18px; letter-spacing: 0.3em; color: var(--paper-2); }
.trib-text small { color: var(--paper-3); }
.trib-gather i {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #f3d999;
  box-shadow: 0 0 12px 3px rgba(243, 217, 153, 0.7);
  opacity: 0;
  animation: gather 1.2s var(--delay) ease-in forwards;
}
.lv-light .trib-clouds { animation: none; opacity: 0.5; }

/* —— 静室页 —— */

.history-day { margin-bottom: 14px; }
.history-date {
  display: flex;
  justify-content: space-between;
  margin: 6px 0;
  padding-bottom: 4px;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-brush);
  font-size: 19px;
  font-weight: normal;
  letter-spacing: 0.06em;
  color: var(--paper-2);
}
.history-date span { font-family: var(--font-body); font-size: 13px; color: var(--paper-3); }
.history-day ul { margin: 0; padding: 0; list-style: none; }
.history-row { display: flex; align-items: center; gap: 12px; padding: 7px 4px; border-bottom: 1px solid rgba(201, 165, 98, 0.06); font-size: 15px; }
.vein { flex: none; width: 4px; height: 20px; border-radius: 2px; }
.history-time { font-family: var(--font-mono); font-size: 14px; color: var(--paper-3); }
.history-method { flex: 1; min-width: 0; }
.history-method small { margin-left: 6px; font-size: 12px; color: var(--paper-3); }
.history-dur { color: var(--paper-2); font-variant-numeric: tabular-nums; }
.badge { padding: 0 6px; border: 1px solid rgba(95, 185, 165, 0.4); border-radius: 3px; font-size: 11px; color: var(--jade); }
.more { text-align: center; }

/* —— 藏经阁 —— */

.library-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
.library-grid.has-detail { grid-template-columns: 1fr minmax(320px, 400px); align-items: start; }
.shelf { position: relative; margin-bottom: 28px; }
.shelf-name { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; font-family: var(--font-brush); font-size: 22px; font-weight: normal; letter-spacing: 0.1em; color: var(--paper-2); }
.shelf-name i { width: 10px; height: 10px; border-radius: 2px; }
.shelf-name small { font-family: var(--font-body); font-size: 12px; color: var(--paper-3); }
.shelf-books { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 6px; min-height: 206px; padding: 14px 14px 0; }
.shelf-plank {
  height: 12px;
  margin-top: -2px;
  border-radius: 2px;
  background: linear-gradient(180deg, #5a3d24, #3a2716 60%, #22170d);
  box-shadow: 0 8px 14px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 220, 170, 0.15);
}
.spine {
  --c: #888;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  height: 192px;
  padding: 16px 0 10px;
  border: 0;
  border-radius: 3px 3px 1px 1px;
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.38), transparent 18%, rgba(255, 255, 255, 0.08) 45%, transparent 70%, rgba(0, 0, 0, 0.38)),
    repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.06) 0 2px, transparent 2px 5px),
    color-mix(in srgb, var(--c) 55%, #1a1410);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), 2px 0 0 rgba(0, 0, 0, 0.35);
  cursor: pointer;
  transition: transform 0.2s var(--ease-out), box-shadow 0.2s;
}
.spine::before, .spine::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; background: rgba(234, 208, 150, 0.45); }
.spine::before { top: 8px; }
.spine::after { bottom: 36px; }
.spine:hover, .spine.on {
  transform: translateY(-10px);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1), 0 10px 18px rgba(0, 0, 0, 0.45), 0 0 0 1px var(--gold);
}
.spine-label {
  max-height: 128px;
  overflow: hidden;
  padding: 8px 3px;
  border-radius: 2px;
  background: linear-gradient(180deg, #efe4c8, #e2d4b0);
  color: #2a2118;
  font-family: var(--font-brush);
  font-size: 18px;
  letter-spacing: 0.12em;
  writing-mode: vertical-rl;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
}
.spine-seal {
  padding: 2px 3px;
  border-radius: 2px;
  background: var(--seal);
  color: #f6e7d0;
  font-size: 11px;
  letter-spacing: 0.1em;
  writing-mode: vertical-rl;
  filter: url(#seal-rough);
}
.spine.archived { filter: grayscale(0.8) brightness(0.8); }
.shelf.high { opacity: 0.85; }

.method-detail { position: sticky; top: 20px; max-height: calc(100vh - 40px); overflow-y: auto; }
.detail-name { margin: 0 36px 0 0; font-family: var(--font-brush); font-size: 32px; font-weight: normal; letter-spacing: 0.06em; color: var(--gold-hi); }
.detail-sub { margin: 0 0 10px; color: var(--paper-3); }
.detail-chapter { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 8px; color: var(--paper-2); }
.detail-chapter .input { flex: 1; }
.detail-desc { font-size: 14px; color: var(--paper-2); }
.detail-total { color: var(--paper-2); }
.detail-total b { font-weight: normal; color: var(--paper); }
.mini-bars { display: flex; align-items: flex-end; gap: 2px; height: 48px; margin-top: 8px; }
.mini-bars i { flex: 1; min-height: 2px; border-radius: 2px 2px 0 0; background: #8f8775; }
.mini-bars i.today { background: #d9b45f; }
.mini-caption { margin: 4px 0 12px; font-size: 12px; color: var(--paper-3); }
.detail-block h3 { margin: 14px 0 6px; font-family: var(--font-brush); font-size: 19px; font-weight: normal; color: var(--paper-2); }
.kv-list { margin: 0; padding: 0; list-style: none; }
.kv-list li { display: flex; justify-content: space-between; gap: 10px; padding: 5px 0; border-bottom: 1px solid rgba(201, 165, 98, 0.08); font-size: 14px; }
.kv-list small { color: var(--paper-3); }
.detail-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 18px; }

/* —— 观星台 —— */

.portals { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
.portal {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: auto auto;
  align-items: center;
  column-gap: 12px;
  padding: 12px 14px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  background: rgba(24, 27, 34, 0.6);
  color: var(--paper);
  text-decoration: none;
  transition: transform 0.15s, border-color 0.2s, box-shadow 0.2s;
}
.portal:hover { border-color: var(--gold); transform: translateY(-2px); box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4); }
.portal-eye {
  position: relative;
  grid-row: span 2;
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-family: var(--font-brush);
  font-size: 22px;
}
.portal-eye::before {
  content: '';
  position: absolute;
  inset: -5px;
  border: 1px dashed currentColor;
  border-radius: 50%;
  opacity: 0.45;
  animation: spin 30s linear infinite;
}
.portal-eye.tone-gold { color: var(--gold-hi); background: radial-gradient(circle, rgba(234, 208, 150, 0.2), rgba(234, 208, 150, 0.04)); }
.portal-eye.tone-jade { color: #9fdccd; background: radial-gradient(circle, rgba(95, 185, 165, 0.22), rgba(95, 185, 165, 0.04)); }
.portal-eye.tone-cinnabar { color: #f0a090; background: radial-gradient(circle, rgba(192, 64, 47, 0.25), rgba(192, 64, 47, 0.05)); }
.portal-eye.tone-indigo { color: #a9bdf0; background: radial-gradient(circle, rgba(74, 134, 212, 0.25), rgba(74, 134, 212, 0.05)); }
.portal-name { font-size: 17px; }
.portal-host { overflow: hidden; font-size: 12px; color: var(--paper-3); white-space: nowrap; text-overflow: ellipsis; }
.intel-form { display: grid; grid-template-columns: 2fr 2fr 2fr auto auto; gap: 8px; margin-bottom: 12px; }
.intel-list { margin: 0; padding: 0; list-style: none; }
.intel-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(201, 165, 98, 0.08); }
.intel-main { flex: 1; min-width: 0; }
.intel-title { font-size: 16px; color: var(--paper); text-decoration: none; }
a.intel-title:hover { color: var(--gold-hi); text-decoration: underline; }
.intel-note { margin: 2px 0 0; font-size: 13px; color: var(--paper-3); }
.intel-date { font-size: 12px; color: var(--paper-3); white-space: nowrap; }

/* —— 列表编辑（布阵、传送阵） —— */

.list-editor { display: flex; flex-direction: column; gap: 8px; }
.editor-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border: 1px solid rgba(201, 165, 98, 0.1);
  border-radius: 6px;
  background: rgba(10, 12, 16, 0.35);
}
.editor-row .input { flex: 0 1 170px; }
.editor-row .input.grow { flex: 1 1 220px; }
.editor-row .input.narrow { flex: 0 0 90px; }
.editor-row .input.color { flex: none; }
.row-tools { display: flex; gap: 2px; margin-left: auto; }
.editor-actions { display: flex; align-items: center; gap: 10px; margin-top: 4px; }
.weekdays { display: inline-flex; gap: 3px; }
.weekdays .day {
  width: 28px;
  height: 28px;
  border: 1px solid var(--line-2);
  border-radius: 4px;
  background: none;
  color: var(--paper-3);
  font-size: 13px;
  cursor: pointer;
}
.weekdays .day.on { border-color: var(--gold); background: rgba(201, 165, 98, 0.18); color: var(--gold-hi); }
.form-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 4px 18px; }
.form-actions { display: flex; justify-content: flex-end; margin-top: 8px; }
.toggles { gap: 18px; margin: 4px 0 8px; }
.about ul { margin: 0; padding-left: 20px; line-height: 1.9; color: var(--paper-2); }

/* —— 闻道阁 —— */

.env-list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
.env-list li { padding: 8px 12px; border: 1px solid rgba(192, 64, 47, 0.4); border-radius: 6px; background: rgba(192, 64, 47, 0.08); font-size: 14px; color: #f0c2b8; }
.env-list li.soft { border-color: rgba(201, 165, 98, 0.35); background: rgba(201, 165, 98, 0.06); color: var(--paper-2); }
.wendao-form { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; }
.wendao-form .field { margin: 0; }
.wendao-form .field.grow { flex: 1 1 320px; }
.jobs { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
.job { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 8px; background: rgba(20, 23, 29, 0.85); }
.job-furnace {
  flex: none;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-2);
  border-radius: 50%;
  font-family: var(--font-brush);
  font-size: 20px;
  color: var(--paper-3);
}
.job-furnace.burning {
  border-color: rgba(255, 150, 80, 0.6);
  color: #ffcf8a;
  box-shadow: 0 0 14px rgba(255, 140, 70, 0.35), inset 0 0 10px rgba(255, 140, 70, 0.25);
  animation: furnace 1.6s ease-in-out infinite;
}
.st-done .job-furnace { border-color: var(--gold); color: var(--gold-hi); }
.st-failed .job-furnace { border-color: rgba(192, 64, 47, 0.6); color: #e08a7a; }
.job-main { flex: 1; min-width: 0; }
.job-title { display: block; overflow: hidden; font-size: 16px; color: var(--paper); text-decoration: none; white-space: nowrap; text-overflow: ellipsis; }
.job-title:hover { color: var(--gold-hi); }
.job-meta { display: flex; flex-wrap: wrap; gap: 4px; margin: 2px 0 0; font-size: 13px; color: var(--paper-3); }
.st-done .job-status { color: var(--gold); }
.st-failed .job-status { color: #e08a7a; }
.st-busy .job-status { color: #ffcf8a; }
.job-msg { margin: 4px 0 0; font-size: 13px; color: var(--paper-2); }
.job-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 6px; }

.reader {
  position: relative;
  width: min(820px, 100%);
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  padding: 34px 44px;
  border-radius: 4px;
  background:
    radial-gradient(ellipse at 15% 0%, rgba(255, 255, 255, 0.35), transparent 55%),
    linear-gradient(180deg, #efe6cf, #e8dcc0);
  color: var(--ink);
  font-size: 16px;
  line-height: 1.85;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), inset 0 0 60px rgba(120, 90, 40, 0.15);
}
.reader-title { margin: 0 40px 10px 0; font-family: var(--font-brush); font-size: 30px; font-weight: normal; color: var(--ink); }
.reader-meta {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 2px 12px;
  margin: 0 0 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(43, 36, 28, 0.15);
  font-size: 13px;
  color: #6d5f4a;
}
.reader-meta dt { color: var(--ink-3); }
.reader-meta dd { margin: 0; word-break: break-all; }
.reader-path { margin-top: 24px; padding-top: 10px; border-top: 1px solid rgba(43, 36, 28, 0.15); font-size: 12px; color: var(--ink-3); word-break: break-all; }
.markdown h1, .markdown h2, .markdown h3, .markdown h4 { margin: 1.2em 0 0.4em; font-family: var(--font-brush); font-weight: normal; letter-spacing: 0.04em; color: var(--ink); }
.markdown h1 { font-size: 28px; }
.markdown h2 { padding-bottom: 4px; border-bottom: 1px solid rgba(168, 53, 42, 0.3); font-size: 24px; }
.markdown h3 { font-size: 20px; }
.markdown a { color: #9b2f24; }
.markdown code { padding: 1px 5px; border-radius: 3px; background: rgba(43, 36, 28, 0.08); font-family: var(--font-mono); font-size: 0.92em; }
.markdown pre { overflow-x: auto; padding: 12px 14px; border-radius: 6px; background: var(--ink); color: var(--xuan); }
.markdown pre code { padding: 0; background: none; color: inherit; }
.markdown blockquote { margin: 1em 0; padding: 4px 14px; border-left: 3px solid var(--cinnabar); background: rgba(168, 53, 42, 0.05); color: var(--ink-2); }
.markdown table { width: 100%; border-collapse: collapse; font-size: 14px; }
.markdown th, .markdown td { padding: 5px 8px; border: 1px solid rgba(43, 36, 28, 0.2); }
.markdown hr { border: 0; border-top: 1px solid rgba(43, 36, 28, 0.2); }
.markdown ul, .markdown ol { padding-left: 1.4em; }
.markdown details { margin: 0.6em 0; padding: 6px 10px; border: 1px solid rgba(43, 36, 28, 0.15); border-radius: 4px; }

/* —— 动画 —— */

@keyframes drift { from { transform: translateX(-8%); } to { transform: translateX(8%); } }
@keyframes rise {
  0% { transform: translate(0, 0); opacity: 0; }
  10% { opacity: 0.7; }
  50% { transform: translate(14px, -50vh); opacity: 0.5; }
  90% { opacity: 0.15; }
  100% { transform: translate(-10px, -100vh); opacity: 0; }
}
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes ember { 0%, 100% { opacity: 0.7; transform: scale(0.9); } 50% { opacity: 1; transform: scale(1.15); } }
@keyframes wisp { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -116; } }
@keyframes shimmer { 0% { transform: translateX(-100%); } 60%, 100% { transform: translateX(100%); } }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
@keyframes stamp {
  0% { transform: rotate(-15deg) scale(1.9); opacity: 0; }
  55% { transform: rotate(-7deg) scale(0.86); opacity: 1; }
  100% { transform: rotate(-8deg) scale(1); opacity: 1; }
}
@keyframes inkring { from { opacity: 0.9; transform: scale(0.7); } to { opacity: 0; transform: scale(1.35); } }
@keyframes stampBig {
  0% { transform: rotate(-16deg) scale(2.4); opacity: 0; }
  60% { transform: rotate(-9deg) scale(0.88); opacity: 1; }
  100% { transform: rotate(-10deg) scale(1); opacity: 1; }
}
@keyframes floatUp {
  0% { opacity: 0; transform: translate(-50%, -60%); }
  15% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -260%); }
}
@keyframes shake {
  0%, 100% { transform: translate(0, 0); }
  15% { transform: translate(-4px, 2px); }
  30% { transform: translate(4px, -2px); }
  45% { transform: translate(-3px, -1px); }
  60% { transform: translate(3px, 1px); }
  75% { transform: translate(-1px, 1px); }
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes cloudsRoll { 0% { opacity: 0; transform: translateY(-30px) scale(1.1); } 30% { opacity: 1; } 100% { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes bolt { 0% { stroke-dashoffset: 900; opacity: 1; } 40% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
@keyframes flash { 0% { opacity: 0; } 6% { opacity: 0.75; } 14% { opacity: 0; } 48% { opacity: 0; } 52% { opacity: 0.5; } 60%, 100% { opacity: 0; } }
@keyframes gather {
  0% { transform: translate(var(--dx), var(--dy)) scale(1); opacity: 0; }
  20% { opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(0.3); opacity: 0; }
}
@keyframes furnace { 0%, 100% { box-shadow: 0 0 10px rgba(255, 140, 70, 0.3), inset 0 0 8px rgba(255, 140, 70, 0.2); } 50% { box-shadow: 0 0 20px rgba(255, 140, 70, 0.55), inset 0 0 14px rgba(255, 140, 70, 0.35); } }

/* 特效强度与"减少动态效果" */
body.fx-light .motes, body.fx-none .motes, body.fx-none .mist { display: none; }
body.fx-none .formation, body.fx-none .bar-fill::after, body.fx-none .portal-eye::before { animation: none; }
@media (prefers-reduced-motion: reduce) {
  .motes, .mist { display: none; }
  .formation, .bar-fill::after, .portal-eye::before, .meridians.all .meridian.lit i { animation: none; }
  .incense .wisp { animation-duration: 10s; }
}

/* —— 手机 —— */

@media (max-width: 820px) {
  .rail { display: none; }
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 25;
    display: flex;
    align-items: center;
    gap: 12px;
    height: calc(52px + env(safe-area-inset-top));
    padding: env(safe-area-inset-top) 14px 0;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(10, 12, 16, 0.96), rgba(10, 12, 16, 0.86));
    backdrop-filter: blur(6px);
  }
  .logo-inline { font-family: var(--font-brush); font-size: 24px; letter-spacing: 0.12em; color: var(--gold-hi); text-decoration: none; }
  .topbar-realm { font-family: var(--font-brush); font-size: 17px; color: var(--paper-2); }
  .topbar-settings { margin-left: auto; text-decoration: none; }
  .topbar .nav-seal, .tab .nav-seal { width: 30px; height: 30px; font-size: 18px; }
  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 25;
    display: flex;
    padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(12, 14, 19, 0.92), rgba(8, 10, 13, 0.98));
    backdrop-filter: blur(6px);
  }
  .tab { flex: 1; gap: 2px; font-size: 11px; }
  .tab .nav-label { font-size: 11px; }
  .main { margin-left: 0; padding: calc(64px + env(safe-area-inset-top)) 12px calc(96px + env(safe-area-inset-bottom)); }
  .toasts { top: calc(62px + env(safe-area-inset-top)); }
  .incense-pill { right: 12px; bottom: calc(80px + env(safe-area-inset-bottom)); }
  .moon { width: 60px; height: 60px; top: calc(64px + env(safe-area-inset-top)); right: 10px; }

  .home-main, .spirit-grid, .library-grid.has-detail { grid-template-columns: 1fr; }
  .home-main .chamber { order: -1; }
  .realm-head { grid-template-columns: 1fr; gap: 12px; padding: 14px; }
  .countdowns { margin-left: 0; }
  .panel { padding: 14px 14px 16px; }
  .view-title { font-size: 32px; }
  .chamber-active { grid-template-columns: 110px 1fr; gap: 6px 14px; }
  .chamber.big .chamber-active { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  .chamber.big .chamber-incense { width: auto; max-height: 240px; }
  .chamber.big .chamber-actions { justify-content: center; }
  .chamber-idle, .chamber.big .chamber-idle { grid-template-columns: 1fr; }
  .chamber-idle .chamber-incense { display: none; }
  .clock { font-size: 40px; }
  .chamber.big .clock { font-size: 58px; }
  .picker { grid-template-columns: repeat(2, 1fr); }
  .donut-wrap { grid-template-columns: 1fr; justify-items: center; }
  .donut-figure { width: min(260px, 78vw); }
  .donut-side { width: 100%; }
  .intel-form { grid-template-columns: 1fr; }
  .method-detail {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    max-height: 82vh;
    padding-bottom: calc(20px + env(safe-area-inset-bottom));
    border-radius: 14px 14px 0 0;
  }
  /* 底部抽屉要不透明，后面压一层暗幕，免得书脊透出来 */
  .method-detail.panel {
    background: linear-gradient(180deg, #1e222b, #15181e);
    box-shadow: 0 -18px 50px rgba(0, 0, 0, 0.6), 0 0 0 100vmax rgba(5, 6, 9, 0.6);
  }
  .shelf-books { min-height: 186px; padding: 12px 6px 0; }
  .spine { height: 172px; }
  .reader { padding: 24px 18px; }
  .paper-inner { padding: 22px 20px 20px; }
  .scroll-rows > div { grid-template-columns: 70px 1fr; }
  .scroll-title { font-size: 34px; }
  .stamp { width: 54px; height: 54px; font-size: 21px; top: 14px; right: 14px; }
  .job { flex-wrap: wrap; }
  .job-actions { justify-content: flex-start; width: 100%; }
  .history-time { font-size: 12px; }
}
